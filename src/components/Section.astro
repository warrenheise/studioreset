---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  theme?: "white" | "dark" | "dark-bold" | "black" | "black-bold";
  rowsM: number;
  rowsD: number;
  bg?: ImageMetadata;
  bgPosition?: string;
  overlay?: number;
  minHeight?: string;
  id?: string;
  label?: string;
  eager?: boolean;
  // Lossy WebP smears fine repeating patterns; those stay PNG.
  bgFormat?: "webp" | "png";
  // Squarespace's background parallax "intensity" (0 = off). The background
  // is made this much taller than the section and drifts as the page scrolls.
  parallax?: number;
};

const { theme = "black", rowsM, rowsD, bg, bgPosition = "50% 50%", overlay = 0, minHeight, id, label, eager = false, bgFormat = "webp", parallax = 0 } = Astro.props;
// Travel as a share of the background's own (taller) height.
const shift = parallax ? ((parallax / 2) / (100 + parallax)) * 100 : 0;
const hasVideo = Astro.slots.has("background");
---
<section
  class="section"
  data-theme={theme}
  id={id}
  aria-label={label}
  style={`--overlay:${overlay};${minHeight ? `min-height:${minHeight};` : ""}`}
>
  {(bg || hasVideo) && (
    <div
      class:list={["section-bg", { parallax: parallax > 0 }]}
      aria-hidden="true"
      style={parallax ? `--px-grow:${parallax / 2}%;--px-shift:${shift.toFixed(2)}%` : undefined}
    >
      {hasVideo ? <slot name="background" /> : bg && (
        <Image
          src={bg}
          alt=""
          widths={[640, 1024, 1600, 2400].filter((w) => w <= bg.width)}
          sizes="100vw"
          format={bgFormat}
          quality={70}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : undefined}
          style={`object-position:${bgPosition}`}
        />
      )}
    </div>
  )}
  <div class="grid" style={`--rows-m:${rowsM};--rows-d:${rowsD}`}>
    <slot />
  </div>
</section>
