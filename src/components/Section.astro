---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  theme?: "white" | "dark" | "dark-bold" | "black" | "black-bold";
  rowsM: number;
  rowsD: number;
  bg?: ImageMetadata;
  // Optional separate crop for phones, for backgrounds too wide to crop well.
  bgMobile?: ImageMetadata;
  bgPosition?: string;
  overlay?: number;
  minHeight?: string;
  id?: string;
  label?: string;
  eager?: boolean;
  // Lossy WebP smears fine repeating patterns; those stay PNG.
  bgFormat?: "webp" | "png";
  // Squarespace's background parallax "intensity" (0 = off): the background
  // scrolls this many percent slower than the page.
  parallax?: number;
};

const { theme = "black", rowsM, rowsD, bg, bgMobile, bgPosition = "50% 50%", overlay = 0, minHeight, id, label, eager = false, bgFormat = "webp", parallax = 0 } = Astro.props;
const hasVideo = Astro.slots.has("background");
const mobileSrcset = bgMobile
  ? (await Promise.all([480, 960].filter((w) => w <= bgMobile.width).map(async (w) => {
      const img = await getImage({ src: bgMobile, width: w, format: bgFormat, quality: 70 });
      return `${img.src} ${w}w`;
    }))).join(", ")
  : "";
---
<section
  class="section"
  data-theme={theme}
  id={id}
  aria-label={label}
  style={`--overlay:${overlay};${minHeight ? `min-height:${minHeight};` : ""}`}
>
  {(bg || hasVideo) && (
    <div
      class:list={["section-bg", { parallax: parallax > 0 }]}
      aria-hidden="true"
      data-parallax={parallax ? parallax / 100 : undefined}
    >
      {hasVideo ? <slot name="background" /> : bg && (
        <picture>
        {bgMobile && <source media="(max-width: 767px)" srcset={mobileSrcset} sizes="100vw" />}
        <Image
          src={bg}
          alt=""
          widths={[640, 1024, 1600, 2400].filter((w) => w <= bg.width)}
          sizes="100vw"
          format={bgFormat}
          quality={70}
          loading={eager ? "eager" : "lazy"}
          fetchpriority={eager ? "high" : undefined}
          style={`object-position:${bgPosition}`}
        />
        </picture>
      )}
    </div>
  )}
  <div class="grid" style={`--rows-m:${rowsM};--rows-d:${rowsD}`}>
    <slot />
  </div>
</section>
