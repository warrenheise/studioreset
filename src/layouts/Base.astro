---
import "@fontsource/poppins/latin-300.css";
import "@fontsource/poppins/latin-300-italic.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-700.css";
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/images/logo_header01.png";
import footerLogo from "../assets/images/Asset_12.png";
import Section from "../components/Section.astro";
import Block from "../components/Block.astro";
import { organization, site, socials } from "../data/site";

type Props = {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
};

const { title, description, jsonLd = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(base.length) || "/";
// Canonical URLs always point at the real domain, even on preview hosts.
const canonical = new URL(path, site.url).href;
const ogImage = new URL("/social.png", site.url).href;
const nav = [
  { label: "About Us", href: `${base}/#about` },
  { label: "Team", href: `${base}/team/` },
  { label: "The Eventide", href: `${base}/theeventide/` },
  { label: "Contact", href: "#contact" },
  { label: "Discord", href: site.discordUrl, external: true }
];
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    { "@type": "WebSite", "@id": `${site.url}/#website`, url: `${site.url}/`, name: site.name, publisher: { "@id": organization["@id"] } },
    ...jsonLd
  ]
};
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#80ffb9" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Studio Reset logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@StudioResetGame" />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="logo" href={`${base}/`} aria-label="Studio Reset home">
        <Image src={logo} alt="Studio Reset" height={160} loading="eager" format="webp" />
      </a>
      <nav class="nav" aria-label="Main">
        <ul>
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={!item.external && item.href === `${base}${path}` ? "page" : undefined}
                {...(item.external ? { target: "_blank", rel: "noopener" } : {})}
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
        <span class="visually-hidden">Menu</span>
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 4v24M4 16h24" stroke="currentColor" stroke-width="2.5" /></svg>
      </button>
    </header>
    <div class="mobile-menu" id="mobile-menu">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} {...(item.external ? { target: "_blank", rel: "noopener" } : {})}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <Section theme="dark" rowsM={11} rowsD={8}>
        <Block m="2/2/5/7" d="2/2/4/6" jm="center" jd="center">
          <Image src={footerLogo} alt="Studio Reset" widths={[300, 600]} sizes="(min-width: 768px) 16vw, 60vw" format="webp" class="contain" />
        </Block>
        <Block m="5/2/8/10" d="4/2/7/18">
          <p class="small">
            <strong>Studio Reset</strong><br />
            Located in {site.location}<br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </Block>
        <Block m="8/2/10/10" d="7/2/8/14">
          <ul class="social">
            {socials.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" aria-label={`Studio Reset on ${s.name}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.path} /></svg>
                </a>
              </li>
            ))}
          </ul>
        </Block>
      </Section>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
      const menu = document.getElementById("mobile-menu")!;
      const setOpen = (open: boolean) => {
        toggle.setAttribute("aria-expanded", String(open));
        menu.classList.toggle("open", open);
        document.body.classList.toggle("menu-open", open);
      };
      toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
      menu.addEventListener("click", (e) => { if ((e.target as Element).closest("a")) setOpen(false); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });

      // Background parallax. Each background is grown by its factor of the
      // scroll distance it can travel, then shifted against the scroll, so it
      // moves that much slower than the page without showing an edge.
      const layers = [...document.querySelectorAll<HTMLElement>(".section-bg[data-parallax]")];
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
      let ticking = false;
      // Phone browsers resize the viewport as the address bar slides in and
      // out. Re-measuring then would resize the backgrounds mid-scroll, so on
      // phones the height is only re-read when the width changes (rotation).
      let vh = innerHeight;
      let lastWidth = innerWidth;
      const update = () => {
        ticking = false;
        const phone = innerWidth < 768;
        for (const el of layers) {
          // Phones get a third of the effect: the extra height would otherwise
          // zoom the background too far into a narrow screen.
          const factor = reduceMotion.matches ? 0 : Number(el.dataset.parallax) * (phone ? 0.35 : 1);
          const rect = el.parentElement!.getBoundingClientRect();
          const reach = (factor * (vh + rect.height)) / 2;
          el.style.inset = `${-reach}px 0`;
          if (!factor) { el.style.transform = ""; continue; }
          if (rect.bottom < 0 || rect.top > vh) continue;
          const fromCenter = rect.top + rect.height / 2 - vh / 2;
          el.style.transform = `translate3d(0, ${-fromCenter * factor}px, 0)`;
        }
      };
      const request = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      if (layers.length) {
        addEventListener("scroll", request, { passive: true });
        addEventListener("resize", () => {
          if (innerWidth >= 768 || innerWidth !== lastWidth) vh = innerHeight;
          lastWidth = innerWidth;
          request();
        });
        reduceMotion.addEventListener("change", request);
        update();
      }

      // Fade blocks in as they scroll into view, like the original site.
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add("in"); io.unobserve(entry.target); }
      }, { rootMargin: "0px 0px -5% 0px" });
      document.querySelectorAll(".fade").forEach((el) => io.observe(el));
      // A fast jump (fling, anchor link, End key) can skip past an item without
      // it ever intersecting, so also reveal anything already scrolled above.
      let fadeTick = false;
      addEventListener("scroll", () => {
        if (fadeTick) return;
        fadeTick = true;
        requestAnimationFrame(() => {
          fadeTick = false;
          for (const el of document.querySelectorAll(".fade:not(.in)")) {
            if (el.getBoundingClientRect().top < innerHeight) { el.classList.add("in"); io.unobserve(el); }
          }
        });
      }, { passive: true });
    </script>
  </body>
</html>
