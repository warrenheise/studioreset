---
// Squarespace served the home page at both / and /home. Keep old links working
// and point search engines at the one canonical address.
const target = `${import.meta.env.BASE_URL}`;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <title>Studio Reset</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://studioreset.io/" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body><a href={target}>Studio Reset home</a></body>
</html>
